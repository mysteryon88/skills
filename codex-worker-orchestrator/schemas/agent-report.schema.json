{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/agent-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "role", "status", "summary", "evidence", "inferences", "changed_files", "tests", "findings", "concerns"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "report_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "status": {"type": "string", "enum": ["DONE", "DONE_WITH_CONCERNS", "NEEDS_CONTEXT", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "inferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "changed_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "concerns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommended_next_step": {"type": "string", "minLength": 1},
    "suggested_follow_ups": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "artifact_review": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "sha256", "author_id", "reviewer_id"],
      "properties": {
        "kind": {"type": "string", "enum": ["specification", "plan"]},
        "path": {"type": "string", "pattern": "\\S", "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "filesystem_identity": {"type": "string", "pattern": "^[0-9]+:[1-9][0-9]*$"},
        "author_id": {"type": "string", "pattern": "\\S", "maxLength": 200},
        "reviewer_id": {"type": "string", "pattern": "\\S", "maxLength": 200},
        "specification_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
