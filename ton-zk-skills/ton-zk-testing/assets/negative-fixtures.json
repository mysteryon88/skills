{
  "schemaVersion": 1,
  "curve": "bls12-381",
  "scalarModulusDecimal": "52435875175126190479447740508185965837690552500527637822603658699938581184513",
  "rules": {
    "mutationPolicy": "Start from one locally and on-chain verified fixture, then apply exactly one listed mutation.",
    "failureState": "Assert protected state, replay storage, outgoing actions, reserve, and balance delta, not only the exit code."
  },
  "fixtures": [
    {
