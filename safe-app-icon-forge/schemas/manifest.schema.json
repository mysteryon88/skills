{
  "$id": "urn:safe-app-icon-forge:schema:manifest:3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deterministic_build_format_version": {
      "const": 2
    },
    "files": {
      "additionalProperties": {
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "media_type": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "bytes",
          "media_type",
          "role",
          "sha256"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "formats": {
      "additionalProperties": false,
      "properties": {
        "ico_sizes": {
          "items": {
            "maximum": 256,
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "png_sizes": {
          "items": {
            "maximum": 1024,
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "png_sizes",
        "ico_sizes"
      ],
      "type": "object"
    },
    "manifest_schema_version": {
      "const": 3
    },
    "package_members": {
      "items": {
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "preset": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
              "type": "string"
            },
            "version": {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "version"
          ],
          "type": "object"
        }
      ]
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "version"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "entry_count": {
          "maximum": 256,
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "const": "provenance.json"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "entry_count",
        "sha256"
      ],
      "type": "object"
    },
    "quality_policy": {
      "additionalProperties": false,
      "properties": {
        "full_bleed_allowed": {
          "type": "boolean"
        },
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "optical_center_tolerance_px": {
          "maximum": 256,
          "minimum": 0,
          "type": "integer"
        },
        "safe_margin_px": {
          "maximum": 256,
          "minimum": 0,
          "type": "integer"
        },
        "transparent_corners": {
          "type": "boolean"
        },
        "visual_weight_maximum": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "visual_weight_minimum": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "id",
        "safe_margin_px",
        "optical_center_tolerance_px",
        "visual_weight_minimum",
        "visual_weight_maximum",
        "transparent_corners",
        "full_bleed_allowed"
      ],
      "type": "object"
    },
    "renderer": {
      "additionalProperties": false,
      "properties": {
        "executable_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "lock_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "machine": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "const": "inkscape"
        },
        "platform": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "python_version": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "version_output": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version_output",
        "lock_id",
        "executable_sha256",
        "platform",
        "machine",
        "python_version"
      ],
      "type": "object"
    },
    "review_evidence": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "review/review-evidence.json"
        },
        "review_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "review_output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "review_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "review_source_sha256",
        "review_input_sha256",
        "review_output_sha256"
      ],
      "type": "object"
    },
    "routing": {
      "additionalProperties": false,
      "properties": {
        "ico": {
          "additionalProperties": {
            "enum": [
              "small",
              "large"
            ]
          },
          "type": "object"
        },
        "png": {
          "additionalProperties": {
            "enum": [
              "small",
              "large"
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "png",
        "ico"
      ],
      "type": "object"
    },
    "skill_version": {
      "const": "3"
    },
    "style_lock": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "source/style-lock.json"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "style_id": {
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
              "type": "string"
            },
            "style_version": {
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
              "type": "string"
            }
          },
          "required": [
            "path",
            "style_id",
            "style_version",
            "sha256"
          ],
          "type": "object"
        }
      ]
    },
    "tool": {
      "const": "safe-app-icon-forge"
    },
    "visual_review": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "review/visual-review.json"
        },
        "review_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "review_output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "review_source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "selected_concept": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "status": {
          "const": "pass"
        },
        "total": {
          "maximum": 12,
          "minimum": 10,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "status",
        "total",
        "selected_concept",
        "sha256",
        "review_source_sha256",
        "review_input_sha256",
        "review_output_sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "manifest_schema_version",
    "tool",
    "skill_version",
    "project",
    "preset",
    "style_lock",
    "quality_policy",
    "renderer",
    "formats",
    "routing",
    "provenance",
    "visual_review",
    "review_evidence",
    "deterministic_build_format_version",
    "files",
    "package_members"
  ],
  "title": "Safe App Icon Forge build manifest v3",
  "type": "object"
}
